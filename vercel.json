{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/ops/sync-products",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/ops/health?alert=1",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/hero.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
